# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MODEL_FOR_CHECK=claude-opus-4-5-20251101
ANTHROPIC_TEMPERATURE_FOR_CHECK=0

# Lang Smith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_api_key
LANGSMITH_PROJECT=pr-puzzled-shingle-61

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Database Configuration
DATABASE_URL=sqlite:///./qagent.db

# Sandbox Configuration
DOCKER_SOCKET=unix://var/run/docker.sock
SANDBOX_TIMEOUT=3600
WORKSPACE_BASE_PATH=/tmp/qagent_workspaces

# Cost Control
MAX_ITERATIONS=10
MAX_TOKENS_PER_REQUEST=100000

# Application Settings
DEBUG=False
API_TITLE=QAgent API
API_VERSION=0.1.0

# LLM Provider Configuration (Optional)
# Default is OpenAI. To use Anthropic for specific agents, pass llm_provider="anthropic" 
# when creating the agent in code (see workflow.py for examples)
# LLM_PROVIDER=openai  # Optional: global default (defaults to "openai" if not set)
# AGENT_LLM_PROVIDERS=  # Optional: per-agent configuration

# Valid OpenAI Models:
# - gpt-4o-mini (recommended, fast and cost-effective)
# - gpt-4o (most capable)
# - gpt-4-turbo (high performance)
# - gpt-4 (standard)
# - gpt-3.5-turbo (legacy)
# Note: Model names are case-sensitive
